diff --git a/pg_documentdb/src/test/changefeed/changefeed_hooks_test.c b/pg_documentdb/src/test/changefeed/changefeed_hooks_test.c
new file mode 100644
index 000000000..8773b8b8a
--- /dev/null
+++ b/pg_documentdb/src/test/changefeed/changefeed_hooks_test.c
@@ -0,0 +1,63 @@
+/*-------------------------------------------------------------------------
+ * Copyright (c) Microsoft Corporation. All rights reserved.
+ *
+ * Test-only capture provider for replica identity ownership.
+ *-------------------------------------------------------------------------
+ */
+#include "postgres.h"
+#include "fmgr.h"
+#include "miscadmin.h"
+#include "io/bson_core.h"
+#include "api_hooks_def.h"
+
+PG_MODULE_MAGIC;
+
+static uint64 RequiredCollectionId = 0;
+static ChangeStreamRequiresFullReplicaIdentity_HookType PreviousHook = NULL;
+
+void _PG_init(void);
+void _PG_fini(void);
+PG_FUNCTION_INFO_V1(changefeed_test_require_full);
+
+static bool
+RequiresFull(const MongoCollection *collection)
+{
+	return (RequiredCollectionId != 0 &&
+			collection->collectionId == RequiredCollectionId) ||
+		   (PreviousHook != NULL && PreviousHook(collection));
+}
+
+void
+_PG_init(void)
+{
+	PreviousHook = change_stream_requires_full_replica_identity_hook;
+	change_stream_requires_full_replica_identity_hook = RequiresFull;
+}
+
+void
+_PG_fini(void)
+{
+	if (change_stream_requires_full_replica_identity_hook == RequiresFull)
+	{
+		change_stream_requires_full_replica_identity_hook = PreviousHook;
+	}
+}
+
+Datum
+changefeed_test_require_full(PG_FUNCTION_ARGS)
+{
+	int64 collectionId = PG_GETARG_INT64(0);
+
+	if (!superuser())
+	{
+		ereport(ERROR, (errcode(ERRCODE_INSUFFICIENT_PRIVILEGE),
+						errmsg("test capture provider requires superuser")));
+	}
+	if (collectionId < 0)
+	{
+		ereport(ERROR, (errcode(ERRCODE_INVALID_PARAMETER_VALUE),
+						errmsg("test collection ID cannot be negative")));
+	}
+	RequiredCollectionId = (uint64) collectionId;
+	PG_RETURN_VOID();
+}
diff --git a/pg_documentdb/src/test/changefeed/expected/changefeed_replica_identity.out b/pg_documentdb/src/test/changefeed/expected/changefeed_replica_identity.out
new file mode 100644
index 000000000..83ed1b6be
--- /dev/null
+++ b/pg_documentdb/src/test/changefeed/expected/changefeed_replica_identity.out
@@ -0,0 +1,104 @@
+SET client_min_messages TO warning;
+SET documentdb.enablePreImages TO on;
+CREATE SCHEMA changefeed_test;
+CREATE FUNCTION changefeed_test.assert_state(collection_name text, identity "char", pre_images boolean)
+RETURNS void LANGUAGE plpgsql AS $$
+DECLARE
+    collection_id bigint;
+    actual_identity "char";
+    actual_pre_images boolean;
+BEGIN
+    SELECT c.collection_id,
+           (documentdb_core.bson_to_json_string(c.options)::text::jsonb
+               #>> '{changeStreamPreAndPostImages,enabled}')::boolean
+      INTO STRICT collection_id, actual_pre_images
+      FROM documentdb_api_catalog.collections c
+     WHERE c.database_name = 'changefeed_test' AND c.collection_name = assert_state.collection_name;
+    SELECT relreplident INTO STRICT actual_identity
+      FROM pg_class
+     WHERE oid = format('documentdb_data.documents_%s', collection_id)::regclass;
+    IF actual_identity IS DISTINCT FROM identity OR
+       coalesce(actual_pre_images, false) IS DISTINCT FROM pre_images THEN
+        RAISE EXCEPTION 'Unexpected state: identity %, pre-images %', actual_identity, actual_pre_images;
+    END IF;
+END
+$$;
+CREATE FUNCTION changefeed_test.set_pre_images(collection_name text, enabled boolean)
+RETURNS documentdb_core.bson LANGUAGE SQL AS $$
+    SELECT documentdb_api.coll_mod('changefeed_test', $1,
+        json_build_object('collMod', $1, 'changeStreamPreAndPostImages',
+            json_build_object('enabled', $2))::text::documentdb_core.bson);
+$$;
+DO $$
+DECLARE
+    owned_id bigint;
+BEGIN
+    PERFORM documentdb_api.create_collection('changefeed_test', 'ordinary');
+    PERFORM documentdb_api.create_collection('changefeed_test', 'owned');
+    PERFORM changefeed_test.assert_state('ordinary', 'd', false);
+
+    -- No provider: existing physical transitions and repeated calls still work.
+    PERFORM changefeed_test.set_pre_images('ordinary', true);
+    PERFORM changefeed_test.assert_state('ordinary', 'f', true);
+    PERFORM changefeed_test.set_pre_images('ordinary', true);
+    PERFORM changefeed_test.assert_state('ordinary', 'f', true);
+    PERFORM changefeed_test.set_pre_images('ordinary', false);
+    PERFORM changefeed_test.set_pre_images('ordinary', false);
+    PERFORM changefeed_test.assert_state('ordinary', 'd', false);
+
+    -- FULL set independently must not prevent enabling the logical option.
+    SELECT collection_id INTO STRICT owned_id FROM documentdb_api_catalog.collections
+     WHERE database_name = 'changefeed_test' AND collection_name = 'ordinary';
+    EXECUTE format('ALTER TABLE documentdb_data.documents_%s REPLICA IDENTITY FULL', owned_id);
+    PERFORM changefeed_test.set_pre_images('ordinary', true);
+    PERFORM changefeed_test.assert_state('ordinary', 'f', true);
+    PERFORM changefeed_test.set_pre_images('ordinary', false);
+    PERFORM changefeed_test.assert_state('ordinary', 'd', false);
+END
+$$;
+CREATE FUNCTION changefeed_test.require_full(bigint) RETURNS void
+AS 'changefeed_hooks_test', 'changefeed_test_require_full'
+LANGUAGE C STRICT;
+REVOKE ALL ON FUNCTION changefeed_test.require_full(bigint) FROM PUBLIC;
+DO $$
+DECLARE
+    owned_id bigint;
+BEGIN
+    SELECT collection_id INTO STRICT owned_id FROM documentdb_api_catalog.collections
+     WHERE database_name = 'changefeed_test' AND collection_name = 'owned';
+    PERFORM changefeed_test.require_full(owned_id);
+    -- An owner can require FULL even with logical pre-images disabled.
+    PERFORM changefeed_test.set_pre_images('owned', false);
+    PERFORM changefeed_test.assert_state('owned', 'f', false);
+    PERFORM changefeed_test.assert_state('ordinary', 'd', false);
+    PERFORM changefeed_test.set_pre_images('owned', true);
+    PERFORM changefeed_test.assert_state('owned', 'f', true);
+    PERFORM changefeed_test.set_pre_images('owned', false);
+    PERFORM changefeed_test.assert_state('owned', 'f', false);
+    PERFORM changefeed_test.set_pre_images('owned', false);
+    PERFORM changefeed_test.assert_state('owned', 'f', false);
+
+    -- Metadata changes roll back while a provider keeps physical FULL.
+    PERFORM changefeed_test.set_pre_images('owned', true);
+    BEGIN
+        PERFORM changefeed_test.set_pre_images('owned', false);
+        PERFORM changefeed_test.assert_state('owned', 'f', false);
+        RAISE EXCEPTION 'rollback test' USING ERRCODE = 'ZX001';
+    EXCEPTION WHEN SQLSTATE 'ZX001' THEN
+        NULL;
+    END;
+    PERFORM changefeed_test.assert_state('owned', 'f', true);
+
+    -- Releasing capture does not disable pre-images; a later disable restores DEFAULT.
+    PERFORM changefeed_test.require_full(0);
+    PERFORM changefeed_test.set_pre_images('owned', true);
+    PERFORM changefeed_test.assert_state('owned', 'f', true);
+    PERFORM changefeed_test.set_pre_images('owned', false);
+    PERFORM changefeed_test.assert_state('owned', 'd', false);
+    PERFORM documentdb_api.drop_collection('changefeed_test', 'ordinary');
+    PERFORM documentdb_api.drop_collection('changefeed_test', 'owned');
+END
+$$;
+DROP SCHEMA changefeed_test CASCADE;
+RESET documentdb.enablePreImages;
+RESET client_min_messages;
