+MODULES = changefeed_hooks_test
+PG_CPPFLAGS = -I../../../include -I../../../../pg_documentdb_core/include \
+	$(shell pkg-config --cflags libbson-1.0)
+PG_CFLAGS = -std=gnu99 -Wno-declaration-after-statement
