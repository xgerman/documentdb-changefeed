ARG DOCUMENTDB_IMAGE=ghcr.io/documentdb/documentdb/documentdb-local:pg17-0.117.0
ARG PG_MAJOR=17
FROM docker.io/library/postgres:${PG_MAJOR}-bookworm AS build
ARG PG_MAJOR

RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends \
       build-essential postgresql-server-dev-${PG_MAJOR} python3-psycopg2 \
       pkg-config libbson-dev curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/documentdb-source \
    && curl -fsSL --connect-timeout 20 --max-time 180 \
       https://codeload.github.com/documentdb/documentdb/tar.gz/d9301892d7fa47b6f5bb923c93b1f6915c3b9bad \
       -o /tmp/documentdb-headers.tar.gz \
    && tar -xzf /tmp/documentdb-headers.tar.gz --strip-components=1 -C /opt/documentdb-source \
    && rm /tmp/documentdb-headers.tar.gz

COPY . /usr/src/documentdb-changefeed
WORKDIR /usr/src/documentdb-changefeed
RUN make -s -j2 && make -s install

FROM ${DOCUMENTDB_IMAGE} AS local
ARG PG_MAJOR

USER root
RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends libbson-1.0-0 postgresql-${PG_MAJOR} \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /usr/lib/postgresql/${PG_MAJOR}/lib/pg_documentdb_changefeed.so /usr/lib/postgresql/${PG_MAJOR}/lib/
COPY documentdb_changefeed.control sql/documentdb_changefeed--*.sql /usr/share/postgresql/${PG_MAJOR}/extension/
USER documentdb

FROM local AS test
USER root

RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends python3-psycopg2 \
    && rm -rf /var/lib/apt/lists/*

COPY . /usr/src/documentdb-changefeed
WORKDIR /usr/src/documentdb-changefeed
USER documentdb
ENTRYPOINT ["/bin/bash", "scripts/start-test-postgres.sh"]
